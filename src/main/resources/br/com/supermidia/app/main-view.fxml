<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.CustomMenuItem?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="br.com.supermidia.app.MainController"
            styleClass="app-shell">
    <fx:define>
        <ToggleGroup fx:id="navigationGroup"/>
    </fx:define>

    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="top-bar">
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="brand-block">
                <ImageView fitWidth="34" fitHeight="28" preserveRatio="true">
                    <image>
                        <Image url="@supermidia-logo.png"/>
                    </image>
                </ImageView>
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <Label text="SUPER" styleClass="brand-super"/>
                    <Label text="MÍDIA" styleClass="brand-midia"/>
                </HBox>
            </HBox>

            <Separator orientation="VERTICAL"/>

            <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS" styleClass="current-song-header">
                <Label text="♫" styleClass="song-note"/>
                <Label fx:id="currentSongLabel" text="Nenhuma música carregada"
                       wrapText="true" maxWidth="Infinity" HBox.hgrow="ALWAYS"
                       styleClass="current-song-name"/>
            </HBox>

            <Separator orientation="VERTICAL"/>

            <HBox alignment="CENTER_LEFT" spacing="6" minWidth="280"
                  prefWidth="330" maxWidth="360"
                  styleClass="next-song-header">
                <Label text="Próxima:" styleClass="next-song-caption"/>
                <Label fx:id="nextSongLabel" text="Playlist vazia" maxWidth="Infinity"
                       maxHeight="36" wrapText="true" textOverrun="ELLIPSIS"
                       HBox.hgrow="ALWAYS"
                       styleClass="next-song-name"/>
            </HBox>

            <HBox alignment="CENTER" spacing="7" styleClass="controller-chip">
                <Label text="●" styleClass="connection-dot-disconnected"/>
                <Label text="Controladora: nenhuma" styleClass="controller-value"/>
            </HBox>

            <Button fx:id="panicButton" text="PANIC" disable="true"
                    onAction="#handlePanic" styleClass="panic-button">
                <tooltip>
                    <Tooltip text="Interrompe imediatamente todas as notas e sons MIDI."/>
                </tooltip>
            </Button>
        </HBox>
    </top>

    <left>
        <VBox alignment="TOP_CENTER" spacing="10" styleClass="sidebar">
            <ToggleButton fx:id="presentationNavButton" selected="true"
                          toggleGroup="$navigationGroup" onAction="#handleShowPresentation"
                          styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="4" mouseTransparent="true">
                        <Label text="◉" styleClass="nav-icon"/>
                        <Label text="Ao vivo" styleClass="nav-text"/>
                    </VBox>
                </graphic>
            </ToggleButton>
            <ToggleButton fx:id="playlistNavButton"
                          toggleGroup="$navigationGroup" onAction="#handleShowPlaylist"
                          styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="4" mouseTransparent="true">
                        <Label text="☷" styleClass="nav-icon"/>
                        <Label text="Playlist" styleClass="nav-text"/>
                    </VBox>
                </graphic>
            </ToggleButton>
            <Button onAction="#handleOpenPiano"
                    styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="4" mouseTransparent="true">
                        <Label text="♫" styleClass="nav-icon"/>
                        <Label text="Piano" styleClass="nav-text"/>
                    </VBox>
                </graphic>
                <tooltip>
                    <Tooltip text="Abre o piano em uma janela separada."/>
                </tooltip>
            </Button>
            <Region VBox.vgrow="ALWAYS"/>
            <ToggleButton fx:id="settingsNavButton"
                          toggleGroup="$navigationGroup" onAction="#handleShowSettings"
                          styleClass="nav-button" maxWidth="Infinity">
                <graphic>
                    <VBox alignment="CENTER" spacing="4" mouseTransparent="true">
                        <Label text="⚙" styleClass="nav-icon"/>
                        <Label text="Configurações" styleClass="nav-text, nav-text-small"/>
                    </VBox>
                </graphic>
            </ToggleButton>
        </VBox>
    </left>

    <center>
        <StackPane>
            <VBox fx:id="presentationView" alignment="CENTER" spacing="12"
                  maxWidth="1700" maxHeight="650"
                  styleClass="content-area">
                <VBox alignment="CENTER" spacing="8" maxHeight="280"
                      VBox.vgrow="ALWAYS" styleClass="lyrics-card">
                    <Label fx:id="stageLyricsStatusLabel" text="LETRA SINCRONIZADA"
                           visible="false" managed="false"/>
                    <StackPane fx:id="lyricsViewport" maxWidth="Infinity"
                               VBox.vgrow="ALWAYS" styleClass="lyrics-viewport">
                        <VBox fx:id="lyricsLinesContainer" alignment="TOP_CENTER" spacing="4"
                              maxWidth="Infinity" StackPane.alignment="TOP_CENTER">
                            <Label fx:id="stagePreviousLyricLabel" text="" styleClass="lyrics-line"
                                   wrapText="true" textAlignment="CENTER" maxWidth="1200"/>
                            <Label fx:id="stageCurrentLyricLabel" text=""
                                   styleClass="lyrics-line" wrapText="true"
                                   textAlignment="CENTER" maxWidth="1200"/>
                            <Label fx:id="stageNextLyricLabel" text=""
                                   styleClass="lyrics-line" wrapText="true"
                                   textAlignment="CENTER" maxWidth="1200"/>
                            <Label fx:id="stageIncomingLyricLabel" text="" styleClass="lyrics-line"
                                   wrapText="true" textAlignment="CENTER" maxWidth="1200"/>
                        </VBox>
                    </StackPane>
                </VBox>

                <HBox spacing="8" styleClass="mixer-banks">
                    <VBox alignment="TOP_CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          styleClass="mixer-bank, mixer-bank-active">
                        <HBox fx:id="mixerBankOneContainer" alignment="TOP_CENTER" spacing="4"
                              fillHeight="false" maxWidth="Infinity"/>
                    </VBox>
                    <VBox alignment="TOP_CENTER" spacing="4" HBox.hgrow="ALWAYS"
                          styleClass="mixer-bank, mixer-bank-inactive">
                        <HBox fx:id="mixerBankTwoContainer" alignment="TOP_CENTER" spacing="4"
                              fillHeight="false" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </VBox>

            <VBox fx:id="playlistView" visible="false" managed="false" spacing="16"
                  styleClass="content-area">
                <HBox alignment="CENTER_LEFT" spacing="14">
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="PLAYLIST" styleClass="eyebrow"/>
                        <Label text="Repertório" styleClass="page-title"/>
                        <Label text="Adicione, organize e prepare as músicas antes da apresentação."
                               styleClass="page-subtitle"/>
                    </VBox>
                    <Label fx:id="playlistFileLabel" text="Playlist não salva" styleClass="muted-label"/>
                </HBox>

                <HBox spacing="10">
                    <Button text="Adicionar MIDIs" onAction="#handleAddPlaylistItems" styleClass="primary-button"/>
                    <Button text="Abrir playlist" onAction="#handleOpenPlaylist" styleClass="secondary-button"/>
                    <Button fx:id="savePlaylistButton" text="Salvar playlist" disable="true"
                            onAction="#handleSavePlaylist" styleClass="secondary-button"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="moveUpButton" text="Subir" disable="true"
                            onAction="#handleMovePlaylistItemUp" styleClass="secondary-button"/>
                    <Button fx:id="moveDownButton" text="Descer" disable="true"
                            onAction="#handleMovePlaylistItemDown" styleClass="secondary-button"/>
                    <Button fx:id="removePlaylistButton" text="Remover" disable="true"
                            onAction="#handleRemovePlaylistItem" styleClass="danger-button"/>
                </HBox>

                <ListView fx:id="playlistListView" onMouseClicked="#handlePlaylistClick"
                          styleClass="playlist-list" VBox.vgrow="ALWAYS"/>

                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label fx:id="playlistCountLabel" text="Nenhuma música" styleClass="muted-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Duplo clique prepara a música selecionada" styleClass="muted-label"/>
                </HBox>
            </VBox>

            <VBox fx:id="settingsView" visible="false" managed="false" spacing="18"
                  styleClass="content-area, settings-view">
                <VBox spacing="4">
                    <Label text="CONFIGURAÇÕES" styleClass="eyebrow"/>
                    <Label text="Sistema e dispositivos" styleClass="page-title"/>
                    <Label text="Ajustes que não precisam ocupar a tela de apresentação."
                           styleClass="page-subtitle"/>
                </VBox>

                <VBox spacing="14" styleClass="settings-card">
                    <Label text="Saída MIDI" styleClass="settings-title"/>
                    <Label text="Selecione o módulo ou sintetizador que receberá a reprodução."
                           styleClass="muted-label"/>
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <ComboBox fx:id="midiOutputComboBox" promptText="Selecionar saída MIDI"
                                  onAction="#handleMidiOutputSelection" styleClass="device-combo"
                                  HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        <Button text="Atualizar" onAction="#handleRefreshMidiOutputs"
                                styleClass="secondary-button"/>
                    </HBox>
                </VBox>

                <VBox spacing="10" styleClass="settings-card">
                    <Label text="Controladora" styleClass="settings-title"/>
                    <Label text="A configuração da SMC-Mixer será concluída após a identificação das mensagens MIDI."
                           wrapText="true" styleClass="muted-label"/>
                </VBox>

                <VBox spacing="10" styleClass="settings-card">
                    <Label text="Sobre" styleClass="settings-title"/>
                    <Label text="Informações do aplicativo, versão e links do projeto."
                           styleClass="muted-label"/>
                    <Button text="Sobre o SuperMídia MIDI Player" onAction="#handleShowAbout"
                            styleClass="secondary-button"/>
                </VBox>
                <Region VBox.vgrow="ALWAYS"/>
            </VBox>
        </StackPane>
    </center>

    <bottom>
        <VBox spacing="0" styleClass="transport-area">
            <GridPane styleClass="control-bar">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33.333"/>
                    <ColumnConstraints percentWidth="33.334"/>
                    <ColumnConstraints percentWidth="33.333"/>
                </columnConstraints>

                <HBox alignment="CENTER_LEFT" spacing="10" styleClass="transport-zone">
                    <Label fx:id="statusLabel" text="SEM MÚSICA" visible="false" managed="false"/>
                    <Button fx:id="previousButton" text="⏮" disable="true"
                            onAction="#handlePrevious" styleClass="transport-button"/>
                    <Button fx:id="stopButton" text="⏹" disable="true"
                            onAction="#handleStop" styleClass="transport-button"/>
                    <Button fx:id="playButton" text="▶" disable="true"
                            onAction="#handlePlay" styleClass="play-button"/>
                    <Button fx:id="pauseButton" text="⏸" disable="true"
                            onAction="#handlePause" styleClass="transport-button"/>
                    <Button fx:id="nextButton" text="⏭" disable="true"
                            onAction="#handleNext" styleClass="transport-button"/>
                    <Separator orientation="VERTICAL"/>
                </HBox>

                <HBox alignment="CENTER" spacing="6" GridPane.columnIndex="1"
                      styleClass="adjustment-zone">
                    <VBox alignment="CENTER" spacing="2" styleClass="selector-block">
                        <Label text="TOM" styleClass="micro-label"/>
                        <MenuButton fx:id="transposeMenuButton" text="0"
                                    styleClass="quick-popup-control">
                            <items>
                                <CustomMenuItem hideOnClick="false" styleClass="slider-menu-item">
                                    <content>
                                        <VBox alignment="CENTER" spacing="6" styleClass="vertical-slider-popup">
                                            <Label text="TOM" styleClass="popup-slider-title"/>
                                            <Slider fx:id="transposeSlider" orientation="VERTICAL"
                                                    min="-12" max="12" value="0"
                                                    prefWidth="120" prefHeight="450"
                                                    blockIncrement="1" majorTickUnit="6" minorTickCount="5"
                                                    showTickMarks="true" showTickLabels="true" snapToTicks="true"
                                                    styleClass="vertical-popup-slider"/>
                                        </VBox>
                                    </content>
                                </CustomMenuItem>
                            </items>
                        </MenuButton>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" styleClass="selector-block">
                        <Label text="VELOCIDADE" styleClass="micro-label"/>
                        <MenuButton fx:id="speedMenuButton" text="100%"
                                    styleClass="quick-popup-control">
                            <items>
                                <CustomMenuItem hideOnClick="false" styleClass="slider-menu-item">
                                    <content>
                                        <VBox alignment="CENTER" spacing="6" styleClass="vertical-slider-popup">
                                            <Label text="VELOCIDADE" styleClass="popup-slider-title"/>
                                            <Slider fx:id="speedSlider" orientation="VERTICAL"
                                                    min="50" max="150" value="100"
                                                    prefWidth="120" prefHeight="450"
                                                    blockIncrement="5" majorTickUnit="25" minorTickCount="4"
                                                    showTickMarks="true" showTickLabels="true" snapToTicks="true"
                                                    styleClass="vertical-popup-slider"/>
                                        </VBox>
                                    </content>
                                </CustomMenuItem>
                            </items>
                        </MenuButton>
                    </VBox>
                    <VBox alignment="CENTER" spacing="2" styleClass="selector-block">
                        <Label text="VOLUME" styleClass="micro-label"/>
                        <MenuButton fx:id="masterVolumeMenuButton" text="100%"
                                    styleClass="quick-popup-control">
                            <items>
                                <CustomMenuItem hideOnClick="false" styleClass="slider-menu-item">
                                    <content>
                                        <VBox alignment="CENTER" spacing="6" styleClass="vertical-slider-popup">
                                            <Label text="VOLUME" styleClass="popup-slider-title"/>
                                            <Slider fx:id="masterVolumeSlider" orientation="VERTICAL"
                                                    min="0" max="100" value="100"
                                                    prefWidth="120" prefHeight="450"
                                                    blockIncrement="5" majorTickUnit="25" minorTickCount="4"
                                                    showTickMarks="true" showTickLabels="true" snapToTicks="true"
                                                    styleClass="vertical-popup-slider"/>
                                        </VBox>
                                    </content>
                                </CustomMenuItem>
                            </items>
                        </MenuButton>
                    </VBox>
                </HBox>

                <HBox alignment="CENTER_RIGHT" spacing="10" GridPane.columnIndex="2"
                      styleClass="mode-zone">
                    <VBox alignment="CENTER" spacing="3" styleClass="toggle-block">
                        <Label text="AUTOPLAY" styleClass="micro-label"/>
                        <ToggleButton fx:id="automaticModeToggle" text="●" onAction="#handlePlaybackMode"
                                      styleClass="switch-toggle"/>
                    </VBox>
                    <VBox alignment="CENTER" spacing="3" styleClass="toggle-block">
                        <Label text="PRÉVIA" styleClass="micro-label"/>
                        <ToggleButton text="●" disable="true" styleClass="switch-toggle">
                            <tooltip>
                                <Tooltip text="Função planejada para uma etapa futura."/>
                            </tooltip>
                        </ToggleButton>
                    </VBox>
                </HBox>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="progress-bar-area">
                <Label fx:id="currentTimeLabel" text="00:00" styleClass="time-label"/>
                <Slider fx:id="progressSlider" value="0" disable="true" HBox.hgrow="ALWAYS"/>
                <Label fx:id="durationTimeLabel" text="00:00" styleClass="time-label"/>
                <Separator orientation="VERTICAL"/>
                <HBox alignment="CENTER" spacing="7" styleClass="chord-block">
                    <Label text="ACORDE" styleClass="micro-label"/>
                    <Label fx:id="chordValueLabel" text="—" styleClass="chord-value"/>
                </HBox>
                <Separator orientation="VERTICAL"/>
                <Label fx:id="midiOutputStatusLabel" text="MIDI: desconectado"
                       maxWidth="245" textOverrun="ELLIPSIS" styleClass="midi-output-label"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>
